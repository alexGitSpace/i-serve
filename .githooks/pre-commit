#!/bin/sh
# Redraw the front-page chart, regenerate the site's data and the run journal
# before every commit, and stage the results.
#
# The picture is generated from `bench/plot_predicted_vs_measured.py` and the
# site's numbers from `bench/export_site_data.py`, so a commit that edits a
# prediction or a coefficient and forgets the regeneration leaves the README --
# or the calculator -- showing the previous answer. CI catches that, but a
# commit that has to be amended after a red build is a worse instrument than a
# commit that could not be wrong.
#
# `git add` on an unchanged file is a no-op, so this costs a tenth of a second
# and touches nothing on a commit that did not affect the chart.
#
# Enable it once per clone -- hooks are not carried by `git clone`:
#
#     git config core.hooksPath .githooks
set -e

root=$(git rev-parse --show-toplevel)

python3 "$root/bench/plot_predicted_vs_measured.py" >/dev/null
git add "$root/docs/benchmarks/predicted-vs-measured.svg"

python3 "$root/bench/export_site_data.py" >/dev/null
git add "$root/site/data"

# The run journal is generated whole and staged like the two above. README.md
# is hand-written around its runs block, so it is regenerated but never staged
# here -- that would sweep in edits nobody chose -- and a commit whose staged
# README carries a stale block is refused instead.
python3 "$root/bench/runs.py" >/dev/null
git add "$root/docs/benchmarks/README.md"
if ! git show :README.md | python3 "$root/bench/runs.py" --check-readme; then
    printf 'pre-commit: the runs block in README.md is stale; regenerated in the working tree, stage it\n' >&2
    exit 1
fi

# The ledger, generated whole from the measured modules and staged like the journal.
python3 "$root/bench/ledger.py" >/dev/null
git add "$root/docs/benchmarks/ledger.jsonl"

# --- what a commit may not carry -----------------------------------------
#
# Three rules the repository states elsewhere, enforced here over the index --
# the tree the commit would publish, judged by what was actually staged.
#
# A status glyph in the symptom map. The map is a decision tree, not a progress
# board: a node carries its evidence and its home, and a checkmark on it would
# read as a claim about the node's state that the map does not make.
mark=$(git grep --cached -nE "✅|⚠️|⏳" -- docs/symptom-map.md docs/symptom-map.json || true)
if [ -n "$mark" ]; then
    printf 'pre-commit: a status glyph in the symptom map:\n%s\n' "$mark" >&2
    exit 1
fi

# Non-English repository content (CONTRIBUTING.md, "What a reviewer enforces").
# -I skips binary files, whose bytes decode into stray Cyrillic -- the two
# dashboard screenshots are why that flag is here and not an afterthought.
foreign=$(git grep --cached -lIP "[\x{0400}-\x{04FF}]" -- \
    bench controllers deploy docs router site .github .githooks \
    README.md CONTRIBUTING.md LICENSE CLAUDE.md up.sh down.sh || true)
if [ -n "$foreign" ]; then
    printf 'pre-commit: non-English text in repository content:\n%s\n' "$foreign" >&2
    exit 1
fi

# A credential. The rule and every pattern behind it are in the script, which
# takes a tree-ish so the same check can run on a push and in CI; this is the
# only one of the three whose subject is text nobody wrote, which is why it is
# a file of its own and not four more lines here.
sh "$root/.githooks/no-secrets.sh" --cached
